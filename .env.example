# Required — server will not start if .env is missing or these are empty
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=dbname
SESSION_KEY=32characterormorestring
REDIS_URL=redis://localhost:6379/0
# Redis is required for API auth, rate limits, device SSO, undo tokens, and live SSE fan-out.

# Optional (defaults shown)
PORT=8080
HOST=127.0.0.1
ORDRYN_MODE=full
# ORDRYN_* variables also accept their legacy GOTODO_* names.
BASE_PATH=/
USE_HTTPS=false
# ENV=production turns on HSTS. Session cookies are marked Secure (HTTPS only)
# when USE_HTTPS=true or PUBLIC_URL starts with https://.
# ENV=production
DB_SSLMODE=disable
# Set DB_SSLMODE=require (or true) to enable SSL for PostgreSQL connections.

# Outbound email (Mailgun or SMTP) is configured in Admin → Email.
# Secrets are encrypted at rest using SESSION_KEY — rotating SESSION_KEY
# requires re-entering the Mailgun API key / SMTP password in Admin.

# First-time setup: on first start the server prints a setup token to its log.
# Open /setup in a browser (or POST /api/v2/setup) to create the admin account
# and choose the site mode. No environment variables are needed.

# Optional site branding (env wins over config/config.json when set)
# SITE_NAME=GoTodo
# DEFAULT_TIMEZONE=America/New_York
# SHOW_CHANGELOG=true
# ASSET_VERSION=20251130

# Public site address (include the path prefix if using BASE_PATH). Used for links in
# emails such as password resets; without it they're built from the request's Host
# header, which a client can forge. Strongly recommended for any public site.
# PUBLIC_URL=https://todo.example.com

# Reverse proxies allowed to set X-Forwarded-For (used for rate limits and sign-in
# lockouts). Comma-separated IPs or CIDR ranges, "loopback" (the default: a proxy
# on the same host), "private" (also private networks, e.g. nginx in another
# container) or "none". If your proxy is elsewhere (another container, Cloudflare,
# a load balancer), list its address; the server logs a warning when it sees
# X-Forwarded-For from an address that isn't listed.
# TRUSTED_PROXIES=loopback

# Optional extensions directory (default data/extensions)
# EXTENSIONS_DIR=data/extensions

# Alternate Redis (if REDIS_URL is unset)
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# Prometheus metrics at /metrics (off unless set). Scrape with: Authorization: Bearer <token>
# METRICS_TOKEN=
