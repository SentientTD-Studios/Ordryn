{
  "id": "discord",
  "name": "Discord",
  "version": "1.1.0",
  "host_api": 1,
  "hooks": [
    { "on": "task.created" },
    { "on": "task.updated" },
    { "on": "task.deleted" },
    { "on": "task.commented" }
  ],
  "delivery": {
    "type": "discord.webhook",
    "url_from": "webhook_url"
  },
  "settings": [
    { "key": "webhook_url", "type": "secret", "label": "Channel webhook URL", "required": true, "scope": "project" },
    { "key": "triggers", "type": "hook_select", "label": "Triggers", "scope": "project" },
    { "key": "status_only", "type": "bool", "label": "Only notify when status changes (for task.updated)", "scope": "project" }
  ],
  "templates": {
    "task.created": "New task **{name}** in **{project}** ({url})",
    "task.updated": "Task **{name}** updated to **{status}** in project **{project}**",
    "task.deleted": "Task **{name}** deleted from **{project}**",
    "task.commented": "{actor} commented on **{name}** in **{project}** ({url})"
  }
}
