{
  "id": "activity",
  "name": "Board activity",
  "version": "1.2.0",
  "host_api": 1,
  "description": "JSON webhook for board-level changes: moves (including project/sprint split), archive/restore, tags, overdue, reorder, sprint lifecycle, and membership. Skips routine task.updated noise.",
  "author": "SentientTD Studios",
  "homepage": "https://sentienttd.studio",
  "license": "MIT",
  "icon": "icon.svg",
  "hooks": [
    {
      "on": "task.moved",
      "label": "Task moved (project or sprint)"
    },
    {
      "on": "task.tagged",
      "label": "Tags changed"
    },
    {
      "on": "task.overdue",
      "label": "Task overdue"
    },
    {
      "on": "task.reordered",
      "label": "Tasks reordered"
    },
    {
      "on": "project.updated",
      "label": "Project updated"
    },
    {
      "on": "task.project_changed",
      "label": "Moved to another project"
    },
    {
      "on": "task.sprint_changed",
      "label": "Sprint changed"
    },
    {
      "on": "task.archived",
      "label": "Task archived"
    },
    {
      "on": "task.restored",
      "label": "Task restored"
    },
    {
      "on": "project.archived",
      "label": "Project archived"
    },
    {
      "on": "project.restored",
      "label": "Project restored"
    },
    {
      "on": "project.member_joined",
      "label": "Member joined"
    },
    {
      "on": "project.member_left",
      "label": "Member left"
    },
    {
      "on": "sprint.created",
      "label": "Sprint created"
    },
    {
      "on": "sprint.started",
      "label": "Sprint started"
    },
    {
      "on": "sprint.ended",
      "label": "Sprint ended"
    }
  ],
  "delivery": {
    "type": "http.webhook",
    "url_from": "webhook_url",
    "format": "json"
  },
  "settings": [
    {
      "key": "webhook_url",
      "type": "secret",
      "label": "Webhook URL",
      "description": "HTTPS URL of the receiver (n8n, Zapier, or a listener you write). Private addresses are rejected.",
      "required": true,
      "scope": "project"
    },
    {
      "key": "triggers",
      "type": "hook_select",
      "label": "Triggers",
      "description": "Board activity events. Reorder is one POST with {count}, not one per card.",
      "scope": "project"
    },
    {
      "key": "skip_self",
      "type": "bool",
      "label": "Skip events I caused",
      "description": "Do not post when you are the actor.",
      "scope": "project"
    },
    {
      "key": "claimed_only",
      "type": "bool",
      "label": "Only claimed tasks",
      "description": "Skip events for tasks that nobody has claimed.",
      "scope": "project"
    },
    {
      "key": "min_priority",
      "type": "priority",
      "label": "Minimum priority",
      "description": "Ignore events below this priority.",
      "scope": "project"
    },
    {
      "key": "tag_ids",
      "type": "tag_ids",
      "label": "Only these tags",
      "description": "If any tags are selected, only matching tasks notify.",
      "scope": "project"
    },
    {
      "key": "quiet_hours_start",
      "type": "time",
      "label": "Quiet hours start",
      "description": "Hold deliveries until quiet hours end. Leave blank to send immediately.",
      "scope": "project"
    },
    {
      "key": "quiet_hours_end",
      "type": "time",
      "label": "Quiet hours end",
      "description": "End of the quiet window in your timezone.",
      "scope": "project"
    },
    {
      "key": "digest",
      "type": "digest",
      "label": "Digest",
      "description": "Batch notifications hourly or daily instead of sending immediately.",
      "scope": "project"
    },
    {
      "key": "field_filter",
      "type": "field_filter",
      "label": "Custom field filter",
      "description": "Only notify when this custom field key matches (and equals the value if set).",
      "scope": "project"
    }
  ],
  "templates": {
    "task.moved": "{name} moved in {project} (sprint {sprint}) ({url})",
    "task.tagged": "Tags on {name}: {tags} ({url})",
    "task.overdue": "{name} is overdue ({due_date}) in {project} ({url})",
    "task.reordered": "{count} tasks reordered in {project}",
    "project.updated": "Project {project} was updated by {actor}",
    "task.project_changed": "{name} moved to project {project} ({url})",
    "task.sprint_changed": "{name} is now in sprint {sprint} ({url})",
    "task.archived": "{actor} archived {name} in {project}",
    "task.restored": "{actor} restored {name} in {project} ({url})",
    "project.archived": "Project {project} was archived by {actor}",
    "project.restored": "Project {project} was restored by {actor}",
    "project.member_joined": "{member} joined {project}",
    "project.member_left": "{member} left {project}",
    "sprint.created": "Sprint {sprint} created in {project}",
    "sprint.started": "Sprint {sprint} started in {project}",
    "sprint.ended": "Sprint {sprint} ended in {project}"
  },
  "controls": [
    "send_test",
    "rotate_signing",
    "sample_json"
  ]
}
